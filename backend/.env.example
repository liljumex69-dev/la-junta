# Clave privada de la cuenta que despliega el Safe multifirma y firma en
# nombre del backend contra Arbitrum Sepolia (Capa 2 — Safe Protocol Kit).
#
# No la pongas en ningún commit ni la compartas fuera de tu .env local.
# Sin ella, la Capa 1 (identidad, asociaciones, cuotas, propuestas) sigue
# funcionando igual: nada del backend actual la usa todavía.
DEPLOYER_PRIVATE_KEY=

# Orígenes permitidos por CORS, separados por comas. En producción, agregar
# el dominio real del frontend desplegado (ej. https://la-junta.vercel.app).
# Sin esta variable, cae en los puertos de desarrollo local (3000 y 3001).
ALLOWED_ORIGINS=
