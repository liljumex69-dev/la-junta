# Clave de la API de Claude, usada solo por el chat del centro de ayuda (/api/soporte).
#
# Es opcional. Sin ella el chat sigue siendo navegable: responde con un aviso claro
# de que el chat todavía no está conectado y remite a las preguntas frecuentes que
# ya se muestran en la pantalla. Nada se rompe por no tener la clave puesta.
#
# Con la clave puesta, el chat usa Claude con el contexto de producto de Junta como
# system prompt (src/app/api/soporte/route.ts) y responde cualquier pregunta.
ANTHROPIC_API_KEY=

# URL del backend real (FastAPI + Safe en Arbitrum Sepolia, ver backend/).
# Usada solo por src/app/verificacion/page.tsx — el resto de la app sigue
# siendo simulación en memoria, sin conexión al backend. Sin esta variable,
# cae en http://127.0.0.1:8000 (desarrollo local).
NEXT_PUBLIC_API_URL=

# Opcionales, también solo para /verificacion — id de una asociación real ya
# desplegada y dirección de su Safe, para mostrar de entrada. Caen en los
# valores de la demo del hackathon si se dejan vacíos.
NEXT_PUBLIC_ASOCIACION_DEMO_ID=
NEXT_PUBLIC_SAFE_ADDRESS_DEMO=
